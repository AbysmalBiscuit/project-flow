{
	"name": "project-flow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun src/main.ts",
		"dev": "bun --hot src/main.ts",
		"typecheck": "bun check",
		"test": "sh scripts/test-slot.sh",
		"lint": "bun fmt --check && biome ci --error-on-warnings . && bun src/lint-tokens.ts; token_status=$?; bun src/lint-terms.ts; term_status=$?; test \"$token_status\" = 0 && test \"$term_status\" = 0",
		"format": "bun fmt"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/babel__core": "^7.20.5",
		"@types/bun": "1.4.4",
		"@types/d3-force": "3.0.10",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	},
	"bin": {
		"project-flow": "src/main.ts"
	},
	"packageManager": "bun@1.4.4",
	"dependencies": {
		"@babel/core": "^7.29.7",
		"@babel/parser": "^7.29.9",
		"@babel/plugin-syntax-jsx": "^7.29.7",
		"@babel/plugin-syntax-typescript": "^7.29.7",
		"@stylexjs/babel-plugin": "0.19.1",
		"@stylexjs/stylex": "0.19.1",
		"@tanstack/react-query": "5.104.1",
		"@xyflow/react": "^12.12.0",
		"d3-force": "3.0.0",
		"elkjs": "0.12.0",
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	}
}

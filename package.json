{
	"name": "project-flow",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun src/main.ts",
		"dev": "bun --hot src/main.ts",
		"typecheck": "bun check",
		"test": "sh scripts/test-slot.sh",
		"lint": "biome ci --error-on-warnings . && bun src/lint-tokens.ts && bun src/lint-terms.ts",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@babel/core": "7",
		"@babel/plugin-syntax-jsx": "^8.0.1",
		"@babel/plugin-syntax-typescript": "^8.0.3",
		"@biomejs/biome": "^2.5.15",
		"@stylexjs/babel-plugin": "0.19.1",
		"@types/bun": "^1.4.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	},
	"bin": {
		"project-flow": "src/main.ts"
	},
	"packageManager": "bun@1.4.3",
	"dependencies": {
		"@stylexjs/stylex": "0.19.1",
		"mermaid": "11.17.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	}
}

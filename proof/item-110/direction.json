{
	"base_url": "http://127.0.0.1:4192",
	"serve": ["bun", "proof/serve-graph-restart.ts", "4192"],
	"steps": [
		{ "goto": "/projects/acme%2Fwidget" },
		{ "assert_text": "acme/widget" },
		{ "click": "#view-graph" },
		{
			"assert_text": "acme/platform acme/platform#9 0,0 | acme/widget acme/widget#2 280,0 | acme/widget acme/widget#4 0,120"
		},
		{ "assert_text": "left-to-right" },
		{ "click": "#graph-direction-top-to-bottom" },
		{
			"assert_text": "acme/platform acme/platform#9 0,0 | acme/widget acme/widget#2 0,120 | acme/widget acme/widget#4 280,0"
		},
		{ "assert_text": "top-to-bottom" },
		{ "shot": "direction-down" },
		{ "goto": "http://127.0.0.1:4193/" },
		{ "click": "#proof-stop" },
		{ "assert_text": "stopped" },
		{ "click": "#proof-start" },
		{ "assert_text": "started" },
		{ "goto": "/projects/acme%2Fwidget" },
		{ "assert_text": "acme/widget" },
		{ "click": "#view-graph" },
		{ "assert_text": "top-to-bottom" },
		{
			"assert_text": "acme/platform acme/platform#9 0,0 | acme/widget acme/widget#2 0,120 | acme/widget acme/widget#4 280,0"
		},
		{ "shot": "direction-kept" }
	]
}

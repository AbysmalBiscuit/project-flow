{
	"base_url": "http://127.0.0.1:4174",
	"serve": ["bun", "proof/serve-open.ts"],
	"steps": [
		{ "goto": "/" },
		{ "assert_text": "Overview" },
		{ "assert_text": "Needs you" },
		{ "assert_text": "Inbox" },
		{ "assert_text": "Search tickets" },
		{ "assert_text": "Cards" },
		{ "assert_text": "Graph" },
		{ "assert_text": "Table" },
		{ "assert_text": "Allow notifications" },
		{ "shot": "overview-light" },
		{ "click": "[data-theme-toggle]" },
		{ "assert_text": "Overview" },
		{ "assert_text": "Cards" },
		{ "shot": "overview-dark" },
		{ "click": "[aria-label='Settings']" },
		{ "assert_text": "Settings" },
		{ "shot": "settings-from-header" },
		{ "goto": "/" },
		{ "click": "#overview-refresh" },
		{ "assert_text": "Overview" },
		{ "shot": "overview-refreshed" }
	]
}

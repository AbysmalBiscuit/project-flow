{
	"base_url": "http://127.0.0.1:4175",
	"serve": ["bun", "proof/serve-why.ts", "4175"],
	"steps": [
		{ "goto": "/needs-you" },
		{ "click": "[data-needs='acme/widget#7'] button" },

{
	"base_url": "http://127.0.0.1:4174",
	"serve": ["bun", "proof/serve-open.ts"],
	"steps": [
		{ "goto": "/" },
		{ "assert_text": "Overview" },
		{ "assert_text": "Needs you" },
		{ "assert_text": "All projects" },
		{ "shot": "overview-light" },
		{ "click": "#overview-search" },
		{ "fill": "#overview-search", "text": "board" },
		{ "assert_text": "board" },
		{ "shot": "overview-focus" },
		{ "click": "button[data-theme-toggle]" },
		{ "goto": "/" },
		{ "assert_text": "Overview" },
		{ "shot": "overview-dark" },
		{ "goto": "/settings" },
		{ "assert_text": "Notification triggers" },
		{ "shot": "scroll-dark" },
		{ "click": "button[data-theme-toggle]" },
		{ "assert_text": "Settings" },
		{ "shot": "scroll-light" },
		{ "goto": "/" },
		{ "assert_text": "All projects" },
		{ "click": "a[aria-current='page']" },
		{ "assert_text": "Overview" },
		{ "shot": "hover-light" },
		{ "click": "button[data-theme-toggle]" },
		{ "assert_text": "Overview" },
		{ "click": "a[aria-current='page']" },
		{ "assert_text": "Overview" },
		{ "shot": "hover-dark" }
	]
}

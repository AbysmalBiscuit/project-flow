{
	"base_url": "http://127.0.0.1:47923",
	"serve": [
		"bun",
		"test/fixture-server.ts",
		"--port=47923",
		"--data=/var/tmp/pf-175-walk"
	],
	"steps": [
		{ "goto": "/" },
		{ "assert_text": "Overview" },
		{ "assert_text": "acme/widget" },
		{ "click": "#view-graph" },
		{ "assert_text": "PROJECTS AND THEIR BLOCKERS" },
		{ "assert_text": "acme/widget:0,0" },
		{ "assert_text": "zoom 2 at" },
		{ "shot": "overview-graph" },
		{ "fill": "#graph-pan", "text": "120" },
		{ "assert_text": "panned 120" },
		{ "assert_text": "acme/widget:0,0" },
		{ "shot": "overview-graph-panned" }
	]
}

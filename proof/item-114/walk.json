{
	"base_url": "http://127.0.0.1:4189",
	"serve": ["bun", "proof/serve-inbox-114.ts", "4189", "/var/tmp"],
	"steps": [
		{ "goto": "/inbox" },
		{ "assert_text": "Inbox" },
		{ "assert_text": "All" },
		{ "assert_text": "Needs you" },
		{ "assert_text": "Comments" },
		{ "assert_text": "Blockers cleared" },
		{ "assert_text": "Unread only" },
		{ "assert_text": "Today" },
		{ "assert_text": "14:12" },
		{ "assert_text": "4 unread" },
		{ "assert_text": "Which bot should review this?" },
		{ "click": "#inbox-filter-comment" },
		{ "assert_text": "New comment on #72 from grok-72" },
		{ "click": "#inbox-filter-blockerCleared" },
		{ "assert_text": "devkit#212 closed, #80 can start" },
		{ "click": "#inbox-filter-needsYou" },
		{ "assert_text": "PLAT-212 asks a question about the billing export" },
		{ "click": "#inbox-unread-only" },
		{ "assert_text": "3 unread" },
		{ "assert_text": "Which bot should review this?" },
		{ "click": "#inbox-unread-only" },
		{ "click": "#inbox-filter-all" },
		{ "click": "#inbox-mark-all" },
		{ "assert_text": "0 unread" },
		{ "shot": "inbox-light" },
		{ "click": "button[data-theme-toggle]" },
		{ "assert_text": "Theme dark" },
		{ "shot": "inbox-dark" },
		{ "click": "button[data-theme-toggle]" },
		{ "assert_text": "Theme light" }
	]

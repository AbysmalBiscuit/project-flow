{
	"base_url": "http://127.0.0.1:4187",
	"serve": ["bun", "proof/serve-settings.ts", "4187"],
	"steps": [
		{ "goto": "/settings" },
		{ "assert_text": "Projects" },
		{ "assert_text": "6 of 6 projects" },
		{ "fill": "#project-search", "text": "workcell" },
		{ "assert_text": "1 of 6 projects" },
		{ "shot": "search" },
		{ "goto": "/settings" },
		{ "assert_text": "6 of 6 projects" },
		{ "click": "#project-filter" },
		{ "assert_text": "Tracker" },
		{ "click": "#tracker-linear" },
		{ "assert_text": "1 of 6 projects" },
		{ "assert_text": "Platform" },
		{ "shot": "filter" }
	]
}

{
	"base_url": "http://127.0.0.1:4415",
	"serve": ["bun", "proof/serve-415.ts", "4415"],
	"steps": [
		{ "goto": "/projects/acme%2Fwidget" },
		{ "assert_text": "Ship the legend" },
		{ "click": "button[data-ticket='acme/widget#12']" },
		{
			"click": "aside[data-panel='acme/widget#12']:has(a[aria-label='Open the PR on GitHub'][href='https://github.com/acme/widget/pull/40'][target='_blank']) h2"
		},
		{ "shot": "github-panel-with-pr" },
		{ "goto": "/api/projects/Widget%20launch" },
		{ "assert_text": "\"pullUrl\":\"https://github.com/acme/launch/pull/77\"" },
		{ "goto": "/projects/Widget%20launch" },
		{ "assert_text": "Ship the launch" },
		{ "click": "button[data-ticket='WID-14']" },
		{
			"click": "aside[data-panel='WID-14']:has(a[aria-label='Open on Linear'] + a[aria-label='Open the PR on GitHub'][href='https://github.com/acme/launch/pull/77'][target='_blank']) h2"
		},
		{ "shot": "linear-panel-with-pr" }
	]
}

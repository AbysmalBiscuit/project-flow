{
	"base_url": "http://127.0.0.1:4337",
	"viewport": {
		"width": 1440,
		"height": 900
	},
	"serve": ["bun", "proof/serve-337.ts", "4337"],
	"steps": [
		{
			"goto": "/projects/acme%2Fwidget"
		},
		{
			"assert_text": "Chain b mid"
		},
		{
			"assert_text": "Left to right"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "#project-graph [data-graph-node='acme/widget#2']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#1 | acme/widget acme/widget#2 | acme/widget acme/widget#3"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "#project-graph [data-graph-node='acme/widget#21']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#1 | acme/widget acme/widget#2 | acme/widget acme/widget#20 | acme/widget acme/widget#21 | acme/widget acme/widget#3"
		},
		{
			"shot": "two-chains"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "#project-graph [data-graph-node='acme/widget#2']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#20 | acme/widget acme/widget#21"
		},
		{
			"shot": "removed-one"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "#project-graph [data-graph-node='acme/widget#21']"
		},
		{
			"assert_text": "focus none"
		},
		{
			"shot": "removed-last"
		}
	]
}

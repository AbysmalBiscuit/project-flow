{
	"base_url": "http://127.0.0.1:4321",
	"serve": ["bun", "proof/serve-board.ts", "4321"],
	"steps": [
		{ "goto": "/projects/acme%2Fwidget" },
		{ "assert_text": "Ship the board" },
		{ "click": "button[data-ticket='acme/widget#1']" },
		{ "assert_text": "Expand" },
		{ "shot": "board-side" },
		{ "click": "[aria-label='Expand panel']" },
		{ "assert_text": "Collapse" },
		{ "shot": "board-expanded" },
		{ "click": "[aria-label='Collapse panel']" },
		{ "assert_text": "Expand" },
		{ "shot": "board-collapsed" },
		{ "click": "[aria-label='Expand panel']" },
		{ "assert_text": "Collapse" },
		{ "fill": "#walk-esc", "text": "collapse" },
		{ "assert_text": "Expand" },
		{ "shot": "board-esc-collapsed" },
		{ "fill": "#walk-esc", "text": "close" },
		{ "assert_text": "Ship the board" },
		{ "shot": "board-esc-closed" },
		{ "click": "button[data-ticket='acme/widget#1']" },
		{ "assert_text": "Expand" },
		{ "click": "#view-graph" },
		{ "assert_text": "Fit" },
		{ "click": "[aria-label='Expand panel']" },
		{ "assert_text": "Collapse" },
		{ "shot": "graph-expanded" },
		{ "click": "[aria-label='Collapse panel']" },
		{ "click": "#view-table" },
		{ "assert_text": "Ship the board" },
		{ "click": "tr[data-ticket='acme/widget#1']" },
		{ "assert_text": "Expand" },
		{ "click": "[aria-label='Expand panel']" },
		{ "assert_text": "Collapse" },
		{ "shot": "table-expanded" }
	]
}

{
	"base_url": "http://127.0.0.1:4395",
	"serve": ["bun", "proof/serve-337.ts", "4395"],
	"steps": [
		{ "goto": "/" },
		{ "assert_text": "focus none" },
		{ "fill": "#walk-ctrl", "text": "on" },
		{ "click": "#overview-graph a[data-project='acme/gamma']" },
		{ "assert_text": "focus acme/alpha | acme/beta | acme/gamma" },
		{ "click": "#overview-graph #graph-fit" },
		{ "assert_text": "canvas-flush floats-apart page-fits controls-corner" },
		{ "shot": "overview-focus-fit" },
		{ "fill": "#walk-ctrl", "text": "on" },
		{ "click": "#overview-graph a[data-project='acme/gamma']" },
		{ "assert_text": "focus none" },
		{
			"fill": "#walk-hover",
			"text": "#overview-graph a[data-project='acme/alpha']"
		},
		{ "assert_text": "focus acme/alpha | acme/beta | acme/gamma" },
		{
			"fill": "#walk-style",
			"text": "#overview-graph .react-flow__node:has([data-project='acme/widget'])"
		},
		{ "assert_text": "0.3s opacity 0.2" },
		{ "fill": "#walk-style", "text": "#overview-graph .react-flow__edge" },
		{ "assert_text": "fade opacity 0.2s opacity 1" },
		{ "shot": "overview-hover-fades" },
		{ "fill": "#walk-hover", "text": "leave" },
		{ "assert_text": "focus none" },
		{ "goto": "/projects/acme%2Fwidget" },
		{ "assert_text": "focus none" },
		{ "fill": "#walk-ctrl", "text": "on" },
		{ "click": "#project-graph [data-graph-node='acme/widget#3']" },
		{
			"assert_text": "focus acme/widget acme/widget#1 | acme/widget acme/widget#2 | acme/widget acme/widget#3"
		},
		{ "click": "#project-graph #project-graph-fit" },
		{ "assert_text": "legend-clear" },
		{ "shot": "project-focus-fit" },
		{ "fill": "#walk-ctrl", "text": "on" },
		{ "click": "#project-graph [data-graph-node='acme/widget#3']" },
		{ "assert_text": "focus none" },
		{
			"fill": "#walk-hover",
			"text": "#project-graph [data-graph-node='acme/widget#2']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#1 | acme/widget acme/widget#2 | acme/widget acme/widget#3"
		},
		{
			"fill": "#walk-style",
			"text": "#project-graph .react-flow__node:has([data-graph-node='acme/widget#90'])"
		},
		{ "assert_text": "0.3s opacity 0.2" },
		{
			"fill": "#walk-style",
			"text": "#project-graph .react-flow__edge[data-id$='#13']"
		},
		{ "assert_text": "fade opacity 0.2s opacity 0.2" },
		{ "shot": "project-hover-fades" }
	]
}

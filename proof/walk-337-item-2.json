{
	"base_url": "http://127.0.0.1:4337",
	"viewport": {
		"width": 1440,
		"height": 900
	},
	"serve": ["bun", "proof/serve-337.ts", "4337"],
	"steps": [
		{
			"goto": "/projects/acme%2Fwidget"
		},
		{
			"assert_text": "Chain b mid"
		},
		{
			"assert_text": "Left to right"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "#project-graph [data-graph-node='acme/widget#2']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#1 | acme/widget acme/widget#2 | acme/widget acme/widget#3"
		},
		{
			"click": "#view-board"
		},
		{
			"assert_text": "Clear focus"
		},
		{
			"shot": "board-kept"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "button[data-ticket='acme/widget#21']"
		},
		{
			"shot": "board-add-fork"
		},
		{
			"click": "#view-table"
		},
		{
			"assert_text": "Clear focus"
		},
		{
			"shot": "table-kept"
		},
		{
			"fill": "#walk-ctrl",
			"text": "on"
		},
		{
			"click": "tr[data-ticket='acme/widget#12']"
		},
		{
			"shot": "table-add-chain-a"
		},
		{
			"click": "#view-graph"
		},
		{
			"assert_text": "acme/widget acme/widget#11 | acme/widget acme/widget#12 | acme/widget acme/widget#13"
		},
		{
			"shot": "graph-kept"
		}
	]
}

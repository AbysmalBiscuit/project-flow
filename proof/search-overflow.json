{
	"base_url": "http://127.0.0.1:4188",
	"serve": ["bun", "proof/serve-jump.ts", "4188"],
	"steps": [
		{ "goto": "/" },
		{ "assert_text": "Search tickets" },
		{ "click": "#header-search" },
		{
			"fill": "#jump-query",
			"text": "project-flow ticket search keeps a very long title inside the box"
		},
		{ "assert_text": "sideways scroll bar" },
		{ "shot": "long-query" },
		{ "goto": "/proof/search-fit" },
		{ "assert_text": "dialog 1280 scrollWidth 536 clientWidth 536 fits" },
		{ "assert_text": "list 1280 scrollWidth 512 clientWidth 512 fits" },
		{ "assert_text": "dialog 390 scrollWidth 356 clientWidth 356 fits" },
		{ "assert_text": "list 390 scrollWidth 332 clientWidth 332 fits" },
		{ "shot": "fit-measure" }
	]
}

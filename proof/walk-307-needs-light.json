{
	"base_url": "http://127.0.0.1:4311",
	"serve": ["bun", "proof/serve-needs-you.ts", "4311"],
	"steps": [
		{ "goto": "/needs-you" },
		{ "assert_text": "Ready to merge" },
		{ "click": "[data-needs='acme/widget#8'] button" },
		{ "assert_text": "WHY THIS NEEDS YOU" },
		{ "assert_text": "PR" },
		{ "assert_text": "CI" },
		{ "assert_text": "Review" },
		{ "assert_text": "Comment" },
		{ "assert_text": "Theme light" },
		{ "shot": "needs-panel-light" },
		{ "click": "[data-panel] button[type='submit']" },
		{ "shot": "needs-comment-light" },
		{ "click": "button[data-theme-toggle]" },
		{ "assert_text": "Theme dark" },
		{ "assert_text": "WHY THIS NEEDS YOU" },
		{ "assert_text": "Comment" },
		{ "shot": "needs-panel-dark" },
		{ "click": "[data-panel] button[type='submit']" },
		{ "shot": "needs-comment-dark" },
		{ "click": "#needs-project" },
		{ "assert_text": "All projects" },
		{ "shot": "needs-menu-open" },
		{ "fill": "#walk-esc", "text": "menu" },
		{ "assert_text": "All projects" },
		{ "assert_text": "WHY THIS NEEDS YOU" },
		{ "shot": "needs-menu-esc" },
		{ "fill": "#walk-esc", "text": "panel" },
		{ "assert_text": "Ready to merge" },
		{ "shot": "needs-esc-focus" }
	]
}

{
	"base_url": "http://127.0.0.1:4363",
	"serve": ["bun", "proof/serve-353.ts", "4363"],
	"steps": [
		{ "goto": "/rows" },
		{ "assert_text": "SDI-2 depth 1 open" },
		{ "assert_text": "SDI-6 depth 0 shut" },
		{ "assert_text": "SDI-10 depth 0 open" },
		{ "assert_text": "SDI-11 depth 1 open" },
		{ "assert_text": "SDI-12 depth 2" },
		{ "shot": "sdi-start" },
		{ "goto": "/projects/Initial%20SDI%20Issues" },
		{ "assert_text": "Validate the export schema" },
		{ "click": "[data-toggle='SDI-2']" },
		{ "shot": "sdi-collapsed" },
		{ "goto": "/rows" },
		{ "assert_text": "SDI-2 depth 1 shut" },
		{ "assert_text": "SDI-6 depth 0 shut" },
		{ "shot": "sdi-rows-after-reload" },
		{ "fill": "#walk-search", "text": "export" },
		{ "assert_text": "SDI-2 depth 0 open" },
		{ "assert_text": "SDI-3 depth 1" },
		{ "assert_text": "SDI-4 depth 1" },
		{ "shot": "sdi-search-open" },
		{ "fill": "#walk-search", "text": "   " },
		{ "assert_text": "SDI-2 depth 1 shut" },
		{ "shot": "sdi-search-cleared" },
		{ "goto": "/projects/Initial%20SDI%20Issues" },
		{ "assert_text": "Stand up the SDI pipeline" },
		{ "shot": "sdi-table-after-reload" }
	]
}

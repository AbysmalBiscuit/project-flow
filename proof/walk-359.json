{
	"base_url": "http://127.0.0.1:4359",
	"viewport": {
		"width": 1440,
		"height": 900
	},
	"serve": ["bun", "proof/serve-359.ts", "4359"],
	"steps": [
		{
			"goto": "/projects/acme%2Fwidget"
		},
		{
			"assert_text": "feat: show parent and sub-ticket chips"
		},
		{
			"assert_text": "Left to right"
		},
		{
			"fill": "#walk-boxes",
			"text": "before #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "before: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-before-hover"
		},
		{
			"fill": "#walk-hover",
			"text": "#project-graph [data-graph-node='acme/widget#264']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#264 | acme/widget acme/widget#265 | acme/widget acme/widget#266 | acme/widget acme/widget#267"
		},
		{
			"fill": "#walk-boxes",
			"text": "hover #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "hover: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-hover"
		},
		{
			"fill": "#walk-hover",
			"text": "leave"
		},
		{
			"assert_text": "focus none"
		},
		{
			"fill": "#walk-boxes",
			"text": "after #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "after: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-after-hover"
		},
		{
			"fill": "#walk-hover",
			"text": "#project-graph [data-graph-node='acme/widget#260']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#260 | acme/widget acme/widget#261 | acme/widget acme/widget#262 | acme/widget acme/widget#263"
		},
		{
			"fill": "#walk-boxes",
			"text": "hover-260 #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "hover-260: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-hover-260"
		},
		{
			"fill": "#walk-hover",
			"text": "leave"
		},
		{
			"assert_text": "focus none"
		},
		{
			"fill": "#walk-boxes",
			"text": "after-260 #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "after-260: 17 boxes apart, ids once"
		},
		{
			"fill": "#walk-hover",
			"text": "#project-graph [data-graph-node='acme/widget#275']"
		},
		{
			"assert_text": "focus acme/widget acme/widget#272 | acme/widget acme/widget#273 | acme/widget acme/widget#274 | acme/widget acme/widget#275"
		},
		{
			"fill": "#walk-boxes",
			"text": "hover-275 #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "hover-275: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-hover-275"
		},
		{
			"fill": "#walk-hover",
			"text": "leave"
		},
		{
			"assert_text": "focus none"
		},
		{
			"fill": "#walk-boxes",
			"text": "after-275 #project-graph .react-flow__node-ticket"
		},
		{
			"assert_text": "after-275: 17 boxes apart, ids once"
		},
		{
			"shot": "graph-after-all"
		}

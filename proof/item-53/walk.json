{
	"base_url": "http://127.0.0.1:4176",
	"serve": ["bun", "proof/serve-browser-notification.ts", "4176"],
	"steps": [
		{ "goto": "/?proof=notification" },
		{ "assert_text": "Projects" },
		{ "assert_text": "Event stream open" },
